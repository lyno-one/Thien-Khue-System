{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @thien-khue/contracts build && nest start --watch",
    "build": "pnpm --filter @thien-khue/contracts build && nest build",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @thien-khue/contracts build && tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "prisma:status": "dotenv -e .env.local -- prisma migrate status",
    "prisma:diff": "dotenv -e .env.local -- prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "prisma:validate": "dotenv -e .env.local -- prisma validate",
    "seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "~6.19.3",
    "@supabase/supabase-js": "^2.117.2",
    "@thien-khue/contracts": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "prisma": "~6.19.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
