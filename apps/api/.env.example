# Nest api Thien Khue S — chep thanh .env.local, dien khoa tu D:\intern\CRM_Lyno-\local-integration\.env.local
PORT=3310
# DB Supabase dung chung voi CRM — ?schema=thien_khue de bang _prisma_migrations nam trong schema rieng
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=thien_khue
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRM_API_URL=http://localhost:3220
# Origin web duoc CORS (phan cach bang dau phay)
CORS_ORIGINS=http://localhost:3300
# Sau proxy / CDN: so hop proxy (vd 1), "true" hoac dai IP — de req.ip la IP that (gioi han tan suat). Bo trong khi chay local
TRUST_PROXY=
# Job dong bo don CRM -> ghi nhan / hoa hong cua mang-luoi (giao thanh cong -> du dieu kien; hoan / huy / tra hang -> bi tru).
# So phut giua hai lan chay; BAT MAC DINH: de trong = 10 phut. Chi dat 0 khi muon tat (luc do chi bam tay o /lam-viec/mang-luoi/quan-ly)
MANG_LUOI_DONG_BO_PHUT=10
# Tich hop Sales Training (docs/TICH-HOP-SALES-TRAINING.md): buoc "Luyen tu van voi AI" cho SALE / CSKH.
# Goc Sales Training — web mo form POST toi <url>/api/vao-tu-thien-khue. Bo trong = tat tich hop
SALES_TRAINING_URL=http://localhost:3020
# Bi mat HMAC dung chung (>= 32 ky tu, GIONG HET ben Sales Training). Khong dua ra web / bundle
TICH_HOP_ST_SECRET=
