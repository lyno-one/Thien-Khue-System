// =====================================================================================
// Thien Khue S — HOP DONG DU LIEU CHUNG cua moi module (agent module KHONG tu sua file nay;
// can them cot / bang thi ghi vao muc "Can doi schema" khi tra ket qua).
//
// LUAT CUNG: Prisma CHI quan schema "thien_khue". Schema "public" la cua CRM Lyno —
// khong tao / sua / xoa gi o do, khong `prisma migrate reset`, khong `prisma db pull`.
// Doc bang CRM (public.mau, khach_hang, don_hang...) chi qua CrmDocService ($queryRaw).
// Cot tham chieu CRM (mau_id, crm_user_id, crm_don_id, sdt_chuan) KHONG co FK sang public.
//
// Quy uoc: ten bang / cot tieng Viet khong dau, snake_case. Tien = Decimal(14,0) (dong) —
// interceptor o core tu doi Decimal -> number khi tra ve.
// Cot "nguoi_*_id" la ho_so.id (khong FK de bot quan he nguoc; danh tinh luon tu token).
// =====================================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["thien_khue"]
}

